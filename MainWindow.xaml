<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Gear Helper"
        Height="780"
        Width="1050"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <TabControl>
            <TabItem Header="Item lookup">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <TextBlock Text="Item name:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ItemQueryTextBox"
                                 Width="640"
                                 Margin="8,0,4,0" />
                        <Button x:Name="SearchButton"
                                Content="Search"
                                Width="90"
                                Margin="0,0,4,0"
                                Click="SearchButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ItemStatusTextBlock"
                               Grid.Row="1"
                               Margin="0,10,0,8"
                               Text="Enter an item name and click Search." />
                    <ScrollViewer Grid.Row="2">
                        <StackPanel x:Name="ItemResultsPanel"
                                    Margin="2" />
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Inventory analysis">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <TextBlock Text="Inventory file:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="InventoryPathTextBox"
                                 Width="700"
                                 IsReadOnly="True"
                                 Margin="8,0,4,0"
                                 HorizontalScrollBarVisibility="Auto" />
                        <Button Content="Browse"
                                Width="90"
                                Margin="0,0,4,0"
                                Click="BrowseButton_Click" />
                        <Button x:Name="AnalyzeButton"
                                Content="Analyze"
                                Width="90"
                                IsEnabled="False"
                                Click="AnalyzeButton_Click" />
                    </StackPanel>

                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Row="1"
                               Margin="0,10,0,8"
                               Text="Choose an inventory file to begin." />

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="How to use this tab:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="• In-game, type '/outputfile inventory'."
                                   TextWrapping="Wrap"
                                   Margin="8,0,0,0" />
                        <TextBlock Text="• Open your EQ folder and locate the generated file."
                                   TextWrapping="Wrap"
                                   Margin="8,2,0,0" />
                        <TextBlock Text="• Click Browse, select the inventory file (for example CharacterName_serverName-inventory.txt), then click Analyze."
                                   TextWrapping="Wrap"
                                   Margin="8,2,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="3">
                        <StackPanel x:Name="InventoryResultsPanel"
                                    Margin="2" />
                    </ScrollViewer>

                    <TextBlock Grid.Row="4"
                               Text="Analysis scope: equipped, inventory bags, and bank bags are scanned. Storage and Dragon's Hoard are not included in this analysis." />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
