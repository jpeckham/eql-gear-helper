<UserControl x:Class="EqlGearHelper.Wpf.Views.CleanupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EqlGearHelper.Wpf.ViewModels" xmlns:views="clr-namespace:EqlGearHelper.Wpf.Views"><UserControl.Resources><HierarchicalDataTemplate DataType="{x:Type local:LocationNode}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}"/></HierarchicalDataTemplate><DataTemplate x:Key="CardTemplate"><Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Bold"/></StackPanel></Border></DataTemplate></UserControl.Resources><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Cleanup" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Status}" AutomationProperties.Name="Cleanup status" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12"><Button Content="Import" Command="{Binding ImportCommand}"/><Button Content="Reanalyze" Command="{Binding ReanalyzeCommand}" Margin="8,0"/><Button Content="Export disposal list" Command="{Binding ExportCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0"/><TextBox Width="180" Margin="12,0,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search cleanup items"/><ComboBox Width="150" Margin="8,0" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" AutomationProperties.Name="Cleanup action filter"/></StackPanel><ItemsControl Grid.Row="2" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" Margin="0,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><TreeView ItemsSource="{Binding Locations}" views:TreeSelection.SelectedItem="{Binding SelectedLocationNode, Mode=TwoWay}" AutomationProperties.Name="Inventory location tree"/><DataGrid Grid.Column="1" Margin="8,0" ItemsSource="{Binding Assessments}" SelectedItem="{Binding SelectedAssessment}" AutoGenerateColumns="True" IsReadOnly="True"/><StackPanel Grid.Column="2"><TextBlock Text="Analysis explanation" FontWeight="Bold"/><TextBlock Text="{Binding SelectedAssessment.Explanation}" TextWrapping="Wrap"/></StackPanel></Grid></Grid></UserControl>
