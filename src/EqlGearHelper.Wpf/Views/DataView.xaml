<UserControl x:Class="EqlGearHelper.Wpf.Views.DataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Data Health" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Status}" AutomationProperties.Name="Data health status" AutomationProperties.LiveSetting="Polite"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12"><Button Content="Import catalog" Command="{Binding ImportCatalogCommand}"/><Button Content="Create backup" Command="{Binding BackupCommand}" Margin="8,0"/><Button Content="Recover backup" Command="{Binding RecoverCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="Catalog version" FontWeight="Bold"/><TextBlock Text="{Binding CatalogVersion}"/><TextBlock Text="Ruleset version" FontWeight="Bold"/><TextBlock Text="{Binding RulesetVersion}"/><TextBlock Text="Snapshot identity" FontWeight="Bold"/><TextBlock Text="{Binding SnapshotIdentity}"/></StackPanel></Grid></UserControl>
