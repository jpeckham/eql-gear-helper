<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EqlGearHelper.Wpf.Views"
        Title="EQL Gear Analyzer" Height="860" Width="1280" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <TabControl>
            <TabItem Header="Cleanup"><views:CleanupView DataContext="{Binding Cleanup}" /></TabItem>
            <TabItem Header="Inventory"><views:InventoryView DataContext="{Binding Inventory}" /></TabItem>
            <TabItem Header="Build Planner"><views:BuildPlannerView DataContext="{Binding BuildPlanner}" /></TabItem>
            <TabItem Header="Exaltations"><views:ExaltationsView DataContext="{Binding Exaltations}" /></TabItem>
            <TabItem Header="Data"><views:DataView DataContext="{Binding Data}" /></TabItem>
        </TabControl>
    </Grid>
</Window>
